{
  "name": "rust-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "sqlite:assets": "node scripts/copy-sqlite.mjs",
    "postinstall": "node scripts/copy-sqlite.mjs",
    "wasm": "npm run wasm:viewer && npm run wasm:rawpdf",
    "wasm:viewer": "wasm-pack build viewer --target web --out-dir ../src/wasm/viewer && rm -f src/wasm/viewer/.gitignore",
    "wasm:rawpdf": "wasm-pack build rawpdf --target web --out-dir ../src/wasm/rawpdf && rm -f src/wasm/rawpdf/.gitignore"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.2",
    "sqlite-wasm-vec": "^0.1.11"
  }
}
