# Copy to .env and fill in. Loaded by docker-compose.yml and (once step 3
# lands) by src/album/config.py — the only place in the app that reads env
# vars directly.

# --- Our own Postgres (pgvector), separate from Immich's -------------------
APP_DB_USER=album
APP_DB_PASSWORD=album
APP_DB_NAME=album
# Host port db's 5432 is published on. Change if 5432 is already taken on
# your machine (another Postgres, another compose project, etc.).
APP_DB_HOST_PORT=5432
# Host-side URL (e.g. running `uv run poe migrate` outside Docker, against
# the `db` service's published port above). Inside the `app` container this
# is overridden to point at the `db` hostname instead — see docker-compose.yml.
# Keep this in sync with APP_DB_USER/APP_DB_PASSWORD/APP_DB_NAME/APP_DB_HOST_PORT
# above if you change them; compose .env files don't support interpolating
# one var from another.
DATABASE_URL=postgresql+psycopg://album:album@localhost:5432/album

# --- Immich (docker-compose.immich.yml) -------------------------------------
# Docs: https://docs.immich.app/install/environment-variables
UPLOAD_LOCATION=./data/immich/library
DB_DATA_LOCATION=./data/immich/postgres
IMMICH_VERSION=release
DB_PASSWORD=immich
DB_USERNAME=immich
DB_DATABASE_NAME=immich

# API key generated from Immich's web UI (Account Settings > API Keys),
# used by src/album/immich/client.py from step 4 onward.
IMMICH_API_KEY=

# --- AI / print fulfillment (used from steps 9 and 15 onward) --------------
ANTHROPIC_API_KEY=
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
