# Copy to .env and fill in. Loaded by docker-compose.yml and (once step 3
# lands) by src/album/config.py — the only place in the app that reads env
# vars directly.

# --- Our own Postgres (pgvector), separate from Immich's -------------------
APP_DB_USER=album
APP_DB_PASSWORD=album
APP_DB_NAME=album
# Host port db's 5432 is published on. Change if 5432 is already taken on
# your machine (another Postgres, another compose project, etc.).
APP_DB_HOST_PORT=5432
# Host-side URL (e.g. running `uv run poe migrate` outside Docker, against
# the `db` service's published port above). Inside the `app` container this
# is overridden to point at the `db` hostname instead — see docker-compose.yml.
# Keep this in sync with APP_DB_USER/APP_DB_PASSWORD/APP_DB_NAME/APP_DB_HOST_PORT
# above if you change them; compose .env files don't support interpolating
# one var from another.
DATABASE_URL=postgresql+psycopg://album:album@localhost:5432/album

# --- Immich (docker-compose.immich.yml) -------------------------------------
# Docs: https://docs.immich.app/install/environment-variables
UPLOAD_LOCATION=./data/immich/library
DB_DATA_LOCATION=./data/immich/postgres
# Pin an exact Immich release, not the floating `release` tag — otherwise a
# `docker compose pull`/`up` can jump you onto a new major and break the API
# (v3 changed error codes and album-id validation). Bump deliberately.
IMMICH_VERSION=v3.0.3
DB_PASSWORD=immich
DB_USERNAME=immich
DB_DATABASE_NAME=immich

# API key generated from Immich's web UI (Account Settings > API Keys),
# used by src/album/immich/client.py. Nested under the `immich` settings
# group, so the env var uses the `__` group delimiter. IMMICH__BASE_URL
# defaults to http://localhost:2283/api — override it only for a non-local
# Immich.
IMMICH__API_KEY=

# --- External-library (scan-in-place) ingest — opt-in, off by default -------
# knowledge/build/external-library-ingestion.md. Default is "upload" (copy each
# photo into Immich). Set "external" to register the photo directory as an Immich
# External Library scanned in place — no second copy on disk. External mode also
# needs the read-only bind mount uncommented in docker-compose.immich.yml, with
# PHOTOS_LOCATION below == EXTERNAL_HOST_ROOT and /external == EXTERNAL_CONTAINER_ROOT.
# IMMICH__INGEST_MODE=external
# PHOTOS_LOCATION=/absolute/path/to/your/photos
# IMMICH__EXTERNAL_HOST_ROOT=/absolute/path/to/your/photos
# IMMICH__EXTERNAL_CONTAINER_ROOT=/external

# --- AI / print fulfillment (used from steps 9 and 15 onward) --------------
# ANTHROPIC_API_KEY stays flat (single value, conventional name).
ANTHROPIC_API_KEY=
# Lulu OAuth2 client-credentials, nested under the `lulu` settings group
# (`__` delimiter). The recipient/shipping and product fields have empty
# defaults; set them (LULU__CONTACT_EMAIL, LULU__POD_PACKAGE_ID,
# LULU__SHIPPING_NAME, LULU__SHIPPING_STREET1, LULU__SHIPPING_CITY,
# LULU__SHIPPING_POSTCODE, LULU__SHIPPING_COUNTRY_CODE,
# LULU__SHIPPING_PHONE_NUMBER) only for a real print submission.
LULU__CLIENT_KEY=
LULU__CLIENT_SECRET=
