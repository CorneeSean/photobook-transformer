# --- Global / unanchored (match at any depth, incl. pipeline/ and rust-client/) ---
.venv/
__pycache__/
*.pyc
.env

# IDE / editor project files (per-developer, not shared).
.idea/
.vscode/

# Aesthetic-scorer weights cache (step 31): the ViT-L/14 CLIP checkpoint (~0.9 GB) +
# the LAION head, downloaded by `poe fetch-aesthetic-weights`. Regenerable, never
# committed. Matches the default `QUALITY__WEIGHTS_DIR` (config.py).
.cache/

# Claude Code agent worktrees — untracked repo copies that otherwise get
# traversed by `ruff check .` / pytest and pollute the gate.
.claude/worktrees/

# macOS Finder metadata — noise, never tracked.
.DS_Store

# --- pipeline/ (the Python project; anchored rules now live under pipeline/) ---
# Album dirs hold generated output. Only demo/test fixtures are tracked, and only
# their album.yml (definition) — every other album (personal runs) is ignored
# whole. Add a fixture by allowlisting its album.yml the same way smith-wedding is.
pipeline/data/albums/*
!pipeline/data/albums/.gitkeep
!pipeline/data/albums/smith-wedding/
pipeline/data/albums/smith-wedding/*
!pipeline/data/albums/smith-wedding/album.yml

# Immich's bind-mounted storage (UPLOAD_LOCATION / DB_DATA_LOCATION).
pipeline/data/immich/

# Generated by scripts/build_cat_album.py (source data + script are tracked;
# the rendered book/PDF are regenerable).
pipeline/tests/data/cat-album/book/
pipeline/tests/data/cat-album/assembled.pdf

# --- rust-client/ (Node + Rust/WASM build artifacts) ---
rust-client/node_modules/
rust-client/dist/
# Rust build output + wasm-pack output (any crate under the monorepo).
target/
pkg/

# Local-only state: agent settings, analysis cache, Immich/Postgres data.
/.claude/
/.ua/
/data/
